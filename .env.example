PROJECT_NAME="CampusCopilot AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-campus-copilot"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + pgvector or SQLite fallback for lightweight local verification)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/campuscopilot"
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./campuscopilot.db"
USE_SQLITE_FALLBACK=True

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# University Configuration
DEFAULT_UNIVERSITY_CODE="GU"
DEFAULT_UNIVERSITY_NAME="Geeta University, Panipat"
